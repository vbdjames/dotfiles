# ~/.ssh/config
# SSH client configuration.
# Private keys are NOT tracked in this repo.

# DevPod Start dotfiles.devpod
Host dotfiles.devpod
  ForwardAgent yes
  LogLevel error
  StrictHostKeyChecking no
  UserKnownHostsFile /dev/null
  HostKeyAlgorithms rsa-sha2-256,rsa-sha2-512,ssh-rsa
  ProxyCommand "/usr/local/bin/devpod" ssh --stdio --context default --user vscode dotfiles
  User vscode
# DevPod End dotfiles.devpod
# DevPod Start foo.devpod
Host foo.devpod
  ForwardAgent yes
  LogLevel error
  StrictHostKeyChecking no
  UserKnownHostsFile /dev/null
  HostKeyAlgorithms rsa-sha2-256,rsa-sha2-512,ssh-rsa
  ProxyCommand "/usr/local/bin/devpod" ssh --stdio --context default --user vscode foo
  User vscode
# DevPod End foo.devpod
# DevPod Start homelab.devpod
Host homelab.devpod
  ForwardAgent yes
  LogLevel error
  StrictHostKeyChecking no
  UserKnownHostsFile /dev/null
  HostKeyAlgorithms rsa-sha2-256,rsa-sha2-512,ssh-rsa
  ProxyCommand "/usr/local/bin/devpod" ssh --stdio --context default --user vscode homelab
  User vscode
# DevPod End homelab.devpod
# DevPod Start homelab-ref.devpod
Host homelab-ref.devpod
  ForwardAgent yes
  LogLevel error
  StrictHostKeyChecking no
  UserKnownHostsFile /dev/null
  HostKeyAlgorithms rsa-sha2-256,rsa-sha2-512,ssh-rsa
  ProxyCommand "/usr/local/bin/devpod" ssh --stdio --context default --user vscode homelab-ref
  User vscode
# DevPod End homelab-ref.devpod
# DevPod Start homelab-clean-commits.devpod
Host homelab-clean-commits.devpod
  ForwardAgent yes
  LogLevel error
  StrictHostKeyChecking no
  UserKnownHostsFile /dev/null
  HostKeyAlgorithms rsa-sha2-256,rsa-sha2-512,ssh-rsa
  ProxyCommand "/usr/local/bin/devpod" ssh --stdio --context default --user vscode homelab-clean-commits
  User vscode
# DevPod End homelab-clean-commits.devpod
# Reuse connections for speed; use 1Password as SSH agent
Host *
    ControlMaster auto
    ControlPath ~/.ssh/sockets/%r@%h-%p
    ControlPersist 600
    IdentityAgent ~/.1password/agent.sock
# Add host-specific config below


